[Unit]
Description=Check resale prototype and reconcile TEST payments

[Service]
Type=oneshot
WorkingDirectory=/root/mercari_resale_preview
EnvironmentFile=/root/mercari_resale_preview/.env-preview
ExecStart=/root/mercari_resale_preview/.venv/bin/python -m resale.operations
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/mercari_resale_preview/resale-private
