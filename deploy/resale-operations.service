[Unit]
Description=Check resale prototype and reconcile TEST payments

[Service]
Type=oneshot
WorkingDirectory=/root/mercari_support_app
EnvironmentFile=/root/mercari_support_app/.env-resale
ExecStart=/root/mercari_support_app/.venv-resale/bin/python -m resale.operations
TimeoutStartSec=180
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/root/mercari_support_app/resale-private
